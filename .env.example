# 서버에서 cp .env.example .env 후 값 채우기 - .env는 git에 올리지 않는다(.gitignore·.dockerignore 이중 차단)
# 반영: .env를 바꾼 뒤 `docker compose up -d` (컨테이너 재생성 - restart 만으로는 미반영)

# docker compose 가 기본으로 읽을 파일 - 이 값 덕에 `docker compose up -d --build` 만으로 운영 구성이 뜬다
COMPOSE_FILE=docker-compose.prod.yml

# DB 비밀번호 (필수) - 생성 예: openssl rand -base64 24
DB_PASSWORD=

# ----- 홈페이지 로그인 연동 (Keycloak OIDC) - prod 는 둘 다 필수, 비어 있으면 기동 실패 -----
# realm 의 issuer 주소 (Keycloak 관리 화면 Realm settings > Endpoints 의 OpenID Endpoint Configuration 에서 issuer 값)
OIDC_ISSUER=https://auth.haedal-sos-man-in-the-mirror.com/realms/<realm>
# Keycloak 클라이언트(ondal-be, confidential) 의 Credentials > Client secret
OIDC_CLIENT_SECRET=

# ----- 아래는 비워두면 application.yml prod 프로필의 기본값 사용 -----

# Keycloak 클라이언트 ID. 기본값: ondal-be
#OIDC_CLIENT_ID=ondal-be
# 콜백 주소 - Keycloak 클라이언트 Valid redirect URIs 와 문자 단위로 일치. 기본값: https://ondal-api.haedal-sos-man-in-the-mirror.com/api/auth/callback
#OIDC_REDIRECT_URI=
# 로그인 후 돌아갈 FE 주소(끝에 / 없음). 기본값: https://ondal.haedal-sos-man-in-the-mirror.com
#FE_URL=
# HOJ(문제 은행) FE 주소 - ?app=hoj 로 시작한 로그인이 돌아갈 곳(끝에 / 없음). 기본값: https://oj.haedal-sos-man-in-the-mirror.com
#HOJ_URL=

# FE 오리진 - 쉼표로 여러 개, 공백 금지. 기본값: https://ondal.haedal-sos-man-in-the-mirror.com,https://oj.haedal-sos-man-in-the-mirror.com (Ondal + HOJ)
# *.pages.dev 미리보기 오리진은 CORS는 통과해도 세션 쿠키(lax)가 실리지 않아 로그인 불가
#CORS_ORIGINS=https://ondal.haedal-sos-man-in-the-mirror.com,https://oj.haedal-sos-man-in-the-mirror.com

# 세션 쿠키 - 기본값 lax + secure=true (FE·API가 같은 등록 도메인이라 lax 로 충분, HTTPS 전제)
# FE를 다른 사이트(*.pages.dev 등)에서 띄울 때만 none - CSRF 1차 방어를 잃으므로 임시 용도로만
#COOKIE_SAMESITE=lax
# http://IP:8080 직접 테스트 동안만 false
#COOKIE_SECURE=true
